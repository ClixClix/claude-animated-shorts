{
  "name": "claude-animated-shorts-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion + three.js project for the cartoon 3D story shorts skill.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "stills": "node scripts/bridge-stills.mjs",
    "models": "node scripts/get-models.mjs",
    "typecheck": "tsc --noEmit",
    "test:v2": "node scripts/v2-tests.mjs",
    "episode": "node scripts/produce-episode.mjs all",
    "episode:status": "node scripts/produce-episode.mjs status",
    "episode:audio": "node scripts/produce-episode.mjs audio",
    "episode2:status": "node scripts/produce-box.mjs status",
    "episode2:build": "node scripts/produce-box.mjs build",
    "episode2:check": "node scripts/produce-box.mjs check",
    "episode2:part1": "node scripts/episode02-part1.mjs",
    "episode2:shot01": "node scripts/episode02-shot01-performance.mjs",
    "episode2:local-opening": "node scripts/episode02-local-opening.mjs",
    "episode2:local-shots03-05": "node scripts/episode02-local-shots03-05.mjs",
    "episode2:local-rig-review": "node scripts/episode02-local-rig-review.mjs",
    "episode2:ep1-assets": "node scripts/episode02-episode1-assets-preview.mjs",
    "episode2:style-check": "node scripts/episode02-style-preflight.mjs",
    "episode2:style-preview": "node scripts/episode02-episode1-assets-preview.mjs",
    "episode2:review-sheet": "node scripts/episode02-review-sheet.mjs",
    "episode2:finale-audit": "node scripts/episode02-finale-audit.mjs",
    "episode2:code-audit": "node scripts/episode02-quality-cycle.mjs",
    "episode2:visual-cycle": "node scripts/episode02-quality-cycle.mjs --preview",
    "episode2:motion-preview": "node scripts/episode02-finale-cloud-movie.mjs",
    "episode2:local-full-review": "node scripts/episode02-local-full-review.mjs",
    "episode2:review-existing": "node scripts/episode02-full-review.mjs",
    "episode2:preview-adam": "node scripts/produce-box.mjs build-preview",
    "episode2:adam-edit-test": "node scripts/episode02-adam-edit-test.mjs",
    "episode2:voice-count": "node scripts/episode02-voice-count.mjs",
    "episode2:generate-adam": "node scripts/episode02-generate-voice.mjs",
    "episode2:director-audit": "node scripts/episode02-director-preflight.mjs --strict",
    "episode2:series-music": "node scripts/episode02-series-music.mjs",
    "episode2:remix-preview": "node scripts/episode02-series-music.mjs && node scripts/episode02-finish.mjs --preview",
    "episode2:remix-master": "node scripts/episode02-series-music.mjs && node scripts/episode02-finish.mjs",
    "inthis:next": "node scripts/series-one-prompt.mjs",
    "inthis:next-test": "node --test scripts/series-one-prompt.test.mjs",
    "episode2:action-audit": "node scripts/episode02-action-evidence.mjs",
    "episode2:action-audit-strict": "node scripts/episode02-action-evidence.mjs --strict",
    "episode2:review": "node scripts/produce-box.mjs review",
    "episode2:doctor": "node scripts/produce-box.mjs doctor",
    "episode2:workflow-test": "node --test scripts/episode02-render-inputs.test.mjs scripts/episode02-review-workflow.test.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/bundler": "4.0.530",
    "@remotion/cli": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "@remotion/three": "4.0.530",
    "postprocessing": "6.37.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.530",
    "three": "0.176.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.0.0",
    "@types/three": "0.176.0",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0"
}
